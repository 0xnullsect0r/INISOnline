// INIS cards. Names/counts verified against the official Matagot rulebook (2016),
// the Esoteric Order of Gamers reference, the Inis errata/FAQ and BGG. See docs/rules.md.
// Effect TEXT is paraphrased in our own words (never the publisher's verbatim copy).
//
// Action composition (23) = 17 base game + the Seasons of Inis expansion action cards
//   (4 new "5th-player" cards + the 2 updated Exploration/Druid that replace the base ones).
//   In the base game only the 17 are used; the cards flagged "fourPlayerOnly" are set
//   aside for games with fewer than 4 players.
// Advantage cards: 16 (one per territory). Epic Tale cards: 30 (base game).
// "verified": true once the name AND effect are confirmed; false = effect still provisional.
[
  // ===================== ACTION CARDS — base game (17) =====================
  { "id": "action.bard",                "type": "Action", "name": "Bard",                "count": 1, "verified": true,  "text": "Draw an Epic Tale. (Triskel) Instead, after one of your maneuvers removes one or more opposing clans, gain a Deed.", "art": "cards/action/bard.svg" },
  { "id": "action.citadel",             "type": "Action", "name": "Citadel",             "count": 1, "verified": true,  "text": "Build a Citadel in a territory where you are present, then take an available Advantage card (face-up or from another player's hand).", "art": "cards/action/citadel.svg" },
  { "id": "action.conquest",            "type": "Action", "name": "Conquest",            "count": 1, "verified": true,  "text": "Choose a territory, then move any number of your clans from adjacent territories into it (this may start a clash).", "art": "cards/action/conquest.svg" },
  { "id": "action.craftsmen_peasants",  "type": "Action", "name": "Craftsmen & Peasants","count": 1, "verified": true,  "text": "In every territory where you are present, place one clan for each Citadel there.", "art": "cards/action/craftsmen_peasants.svg" },
  { "id": "action.druid",               "type": "Action", "name": "Druid",               "count": 1, "verified": true,  "text": "Look through the discarded Action cards and add one to your hand. You cannot play this when it is the last card in your hand.", "art": "cards/action/druid.svg" },
  { "id": "action.exploration",         "type": "Action", "name": "Exploration",         "count": 1, "verified": true,  "text": "The Brenn chooses an empty spot touching two territories; draw a new tile, place it there, and add one of your clans.", "art": "cards/action/exploration.svg" },
  { "id": "action.festival",            "type": "Action", "name": "Festival",            "count": 1, "verified": true,  "text": "In a territory where you are present that has a Sanctuary, place a clan and the Festival marker. While it is there, whoever first starts a clash in that territory loses a clan.", "art": "cards/action/festival.svg" },
  { "id": "action.emissaries",          "type": "Action", "name": "Emissaries",          "count": 1, "verified": true,  "text": "Move one of your clans to an adjacent territory without starting a clash.", "art": "cards/action/emissaries.svg" },
  { "id": "action.geis",                "type": "Action", "name": "Geis",                "count": 1, "verified": true,  "text": "(Triskel) When an opponent plays an Action card, cancel its effect and discard it.", "art": "cards/action/geis.svg" },
  { "id": "action.master_craftsman",    "type": "Action", "name": "Master Craftsman",    "count": 1, "verified": true,  "fourPlayerOnly": true, "text": "Discard one card if you can, then draw an Epic Tale. (Triskel) Instead, after you play an Epic Tale, hand it to another player rather than discarding it and gain a Deed.", "art": "cards/action/master_craftsman.svg" },
  { "id": "action.migration",           "type": "Action", "name": "Migration",           "count": 1, "verified": true,  "text": "Choose a territory and move your clans from it into one or more adjacent territories (this may start clashes).", "art": "cards/action/migration.svg" },
  { "id": "action.new_alliance",        "type": "Action", "name": "New Alliance",        "count": 1, "verified": true,  "text": "Replace one of an opponent's clans with one of yours; you must have a clan available to place.", "art": "cards/action/new_alliance.svg" },
  { "id": "action.new_clans",           "type": "Action", "name": "New Clans",           "count": 1, "verified": true,  "text": "Place new clans in a territory where you are present. Placing clans never starts a clash.", "art": "cards/action/new_clans.svg" },
  { "id": "action.sanctuary",           "type": "Action", "name": "Sanctuary",           "count": 1, "verified": true,  "text": "Build a Sanctuary in a territory where you are present, then draw an Epic Tale.", "art": "cards/action/sanctuary.svg" },
  { "id": "action.scouts_spies",        "type": "Action", "name": "Scouts & Spies",      "count": 1, "verified": true,  "fourPlayerOnly": true, "text": "Look at one opponent's Action cards, then you may move one or more of your clans from one territory to an adjacent one.", "art": "cards/action/scouts_spies.svg" },
  { "id": "action.raid",                "type": "Action", "name": "Raid",                "count": 1, "verified": true,  "text": "(Triskel) During a clash, after you attack, take a random Action card from the attacked player; if they have none, remove one of their exposed clans instead.", "art": "cards/action/raid.svg" },
  { "id": "action.warlord",             "type": "Action", "name": "Warlord",             "count": 1, "verified": true,  "text": "(Triskel) Start or join a clash: place one exposed clan in a contested territory and choose who performs the next maneuver.", "art": "cards/action/warlord.svg" },

  // ===== ACTION CARDS — Seasons of Inis expansion (4 new cards for the 5th-player module) =====
  { "id": "action.clans_harmony",       "type": "Action", "name": "Clans Harmony",       "count": 1, "verified": true,  "expansion": "Seasons of Inis", "text": "Place one clan in each shared territory where you are present, or place one clan in any single territory where you are present.", "art": "cards/action/clans_harmony.svg" },
  { "id": "action.coalition",           "type": "Action", "name": "Coalition",           "count": 1, "verified": true,  "expansion": "Seasons of Inis", "text": "From a shared territory, move any number of your clans into one adjacent territory, and name an opponent from that territory who may move their clans along. You instigate any resulting clash, in which neither of you may use Citadels or attack the other.", "art": "cards/action/coalition.svg" },
  { "id": "action.fili",                "type": "Action", "name": "Fili",                "count": 1, "verified": true,  "expansion": "Seasons of Inis", "text": "Place the Fili token in a shared territory. Until the season ends, nothing can start a clash there; the token is then removed.", "art": "cards/action/fili.svg" },
  { "id": "action.the_king_and_the_land","type": "Action","name": "The King and the Land","count": 1, "verified": true,  "expansion": "Seasons of Inis", "text": "Either discard one of your Advantage cards to draw an Epic Tale, or give one of your Advantage cards to another player present in its territory: you gain a Deed and they place a clan there.", "art": "cards/action/the_king_and_the_land.svg" },
  { "id": "action.exploration_seasons", "type": "Action", "name": "Exploration",         "count": 1, "verified": true , "expansion": "Seasons of Inis", "effectId": "action.exploration", "text": "The Brenn chooses an empty spot touching two territories (islands are placed out at sea instead); draw a new tile, place it there, and add one of your clans.", "art": "cards/action/exploration_seasons.svg" },
  { "id": "action.druid_seasons",       "type": "Action", "name": "Druid",               "count": 1, "verified": true , "expansion": "Seasons of Inis", "effectId": "action.druid", "text": "Look through the discarded Action cards and add one to your hand. You cannot play the Druid as the last Action card in your hand.", "art": "cards/action/druid_seasons.svg" },

  // ===================== ADVANTAGE CARDS (16, one per territory) =====================
  { "id": "advantage.meadows",      "type": "Advantage", "name": "Meadows",             "count": 1, "territoryId": "territory.meadows",      "verified": true,  "text": "When you would draw an Epic Tale, draw one extra, keep one of them and discard the rest.", "art": "cards/advantage/meadows.svg" },
  { "id": "advantage.forest",       "type": "Advantage", "name": "Forest",              "count": 1, "territoryId": "territory.forest",       "verified": true,  "text": "After you play an Epic Tale, draw an Epic Tale.", "art": "cards/advantage/forest.svg" },
  { "id": "advantage.mountains",    "type": "Advantage", "name": "Mountains",           "count": 1, "territoryId": "territory.mountains",    "verified": true , "text": "(Triskel) When clans move into the Mountains, ignore the Mountains' territory effect.", "art": "cards/advantage/mountains.svg" },
  { "id": "advantage.highlands",    "type": "Advantage", "name": "Highlands",           "count": 1, "territoryId": "territory.highlands",    "verified": true,  "text": "During a clash in the Highlands, you may change which player is the instigator.", "art": "cards/advantage/highlands.svg" },
  { "id": "advantage.misty_lands",  "type": "Advantage", "name": "Misty Lands",         "count": 1, "territoryId": "territory.misty_lands",  "verified": true,  "text": "Discard one or more Action cards to draw that many Epic Tales, then keep one and discard the rest.", "art": "cards/advantage/misty_lands.svg" },
  { "id": "advantage.cove",         "type": "Advantage", "name": "Cove",                "count": 1, "territoryId": "territory.cove",         "verified": true,  "text": "After you play a Season card, take the Action card set aside during the Assembly into your hand, then set aside one Action card from your hand.", "art": "cards/advantage/cove.svg" },
  { "id": "advantage.salt_mine",    "type": "Advantage", "name": "Salt Mine",           "count": 1, "territoryId": "territory.salt_mine",    "verified": true,  "text": "Take a random Action card from an opponent, then give that player one Action card from your hand.", "art": "cards/advantage/salt_mine.svg" },
  { "id": "advantage.iron_mine",    "type": "Advantage", "name": "Iron Mine",           "count": 1, "territoryId": "territory.iron_mine",    "verified": true,  "text": "When you make an Attack, the defender must both remove an exposed clan and discard an Action card (if they have one).", "art": "cards/advantage/iron_mine.svg" },
  { "id": "advantage.stone_circle", "type": "Advantage", "name": "Stone Circle",        "count": 1, "territoryId": "territory.stone_circle", "verified": true,  "text": "Remove one of your own clans to retrieve an Epic Tale you would otherwise discard, keeping it instead.", "art": "cards/advantage/stone_circle.svg" },
  { "id": "advantage.swamp",        "type": "Advantage", "name": "Swamp",               "count": 1, "territoryId": "territory.swamp",        "verified": true , "text": "This card does nothing, but playing it still counts as playing a Season card instead of passing.", "art": "cards/advantage/swamp.svg" },
  { "id": "advantage.lost_vale",    "type": "Advantage", "name": "Lost Vale",           "count": 1, "territoryId": "territory.lost_vale",    "verified": true,  "text": "After you play a Season card, move any one clan (yours or an opponent's) from a territory adjacent to the Lost Vale into it; this does not start a clash.", "art": "cards/advantage/lost_vale.svg" },
  { "id": "advantage.tir_na_nog",   "type": "Advantage", "name": "Gates of Tír na nÓg", "count": 1, "territoryId": "territory.tir_na_nog",   "verified": true , "text": "When resolving the Gates of Tir na nOg's territory effect, draw one extra Epic Tale, keep one, and discard the rest.", "art": "cards/advantage/tir_na_nog.svg" },
  { "id": "advantage.hills",        "type": "Advantage", "name": "Hills",               "count": 1, "territoryId": "territory.hills",        "verified": true,  "text": "When an Attack is made against you in the Hills, ignore it (remove no clan and discard no card); then draw an Epic Tale or discard an Action card.", "art": "cards/advantage/hills.svg" },
  { "id": "advantage.valley",       "type": "Advantage", "name": "Valley",              "count": 1, "territoryId": "territory.valley",       "verified": true , "text": "After you play a Season card, place one clan in a territory where you are present.", "art": "cards/advantage/valley.svg" },
  { "id": "advantage.plains",       "type": "Advantage", "name": "Plains",              "count": 1, "territoryId": "territory.plains",       "verified": true , "text": "During a clash, move one or more of your clans from the Plains into adjacent territories.", "art": "cards/advantage/plains.svg" },
  { "id": "advantage.moor",         "type": "Advantage", "name": "Moor",                "count": 1, "territoryId": "territory.moor",         "verified": true,  "text": "At any time you may look at the Epic Tale cards in one opponent's hand.", "art": "cards/advantage/moor.svg" },

  // ===================== EPIC TALE CARDS (30, base game) =====================
  { "id": "epic.diarmuid_grainne",  "type": "EpicTale", "name": "Diarmuid and Gráinne", "count": 1, "verified": true , "text": "(Triskel) When one of your clans is removed, place it instead in a different territory where you are present; this never starts a clash.", "art": "cards/epic/diarmuid_grainne.svg" },
  { "id": "epic.eriu",              "type": "EpicTale", "name": "Eriu",                 "count": 1, "verified": true , "text": "In each territory where you are present that holds a Sanctuary, you may place one clan (up to three clans in total).", "art": "cards/epic/eriu.svg" },
  { "id": "epic.battle_frenzy",     "type": "EpicTale", "name": "Battle Frenzy",        "count": 1, "verified": true , "text": "(Triskel) At the end of a clash's Citadels step, every clan sheltering in this territory's citadels is turned out and becomes exposed.", "art": "cards/epic/battle_frenzy.svg" },
  { "id": "epic.kernunos_sanctuary","type": "EpicTale", "name": "Kernunos' Sanctuary",  "count": 1, "verified": true , "text": "In a territory where you are present that has no Sanctuary, place one clan and one Sanctuary.", "art": "cards/epic/kernunos_sanctuary.svg" },
  { "id": "epic.the_otherworld",    "type": "EpicTale", "name": "The Otherworld",       "count": 1, "verified": true , "text": "In one territory where you are present: for each Sanctuary there, place one of your clans or remove one opposing clan (up to three in total).", "art": "cards/epic/the_otherworld.svg" },
  { "id": "epic.balors_eye",        "type": "EpicTale", "name": "Balor's Eye",          "count": 1, "verified": true,  "text": "Remove one clan from any territory.", "art": "cards/epic/balors_eye.svg" },
  { "id": "epic.battle_of_moytura", "type": "EpicTale", "name": "The Battle of Moytura", "count": 1, "verified": true,  "text": "Gather clans from adjacent territories into a territory in conflict.", "art": "cards/epic/battle_of_moytura.svg" },
  { "id": "epic.deirdres_beauty",   "type": "EpicTale", "name": "Deirdre's Beauty",     "count": 1, "verified": true,  "text": "Draw several Epic Tales, add one to your hand and discard the rest, then remove one of your clans from any territory.", "art": "cards/epic/deirdres_beauty.svg" },
  { "id": "epic.tale_of_cuchulain", "type": "EpicTale", "name": "Tale of Cúchulain",    "count": 1, "verified": true,  "text": "(Triskel, as a maneuver) Remove up to two exposed clans from the clashing territory.", "art": "cards/epic/tale_of_cuchulain.svg" },
  { "id": "epic.dagdas_club",       "type": "EpicTale", "name": "Dagda's Club",         "count": 1, "verified": true , "text": "(Triskel) When an attack removes one of your clans, the clan is not lost: put it right back.", "art": "cards/epic/dagdas_club.svg" },
  { "id": "epic.dagdas_harp",       "type": "EpicTale", "name": "Dagda's Harp",         "count": 1, "verified": true , "text": "For each other Epic Tale card in your hand, place one clan in a territory where you are present (up to three clans).", "art": "cards/epic/dagdas_harp.svg" },
  { "id": "epic.lugs_spear",        "type": "EpicTale", "name": "Lug's Spear",          "count": 1, "verified": true,  "text": "(Triskel) During a clash, no Triskel cards may be played in response until the clash ends.", "art": "cards/epic/lugs_spear.svg" },
  { "id": "epic.dagdas_cauldron",   "type": "EpicTale", "name": "Dagda's Cauldron",     "count": 1, "verified": true , "text": "(Triskel) As a clash ends, return all of your clans removed during it to the territory where it happened.", "art": "cards/epic/dagdas_cauldron.svg" },
  { "id": "epic.tuans_memory",      "type": "EpicTale", "name": "Tuan's Memory",        "count": 1, "verified": true , "text": "Draw three Epic Tale cards, add one to your hand, and discard the others.", "art": "cards/epic/tuans_memory.svg" },
  { "id": "epic.the_morrigan",      "type": "EpicTale", "name": "The Morrigan",         "count": 1, "verified": true,  "text": "You may flip the Flock of Crows token, then start a clash in any territory and choose a present player to be the instigator.", "art": "cards/epic/the_morrigan.svg" },
  { "id": "epic.cathbads_word",     "type": "EpicTale", "name": "Cathbad's Word",       "count": 1, "verified": true , "text": "At the start of the Assembly, you choose which Action card is set aside for the round.", "art": "cards/epic/cathbads_word.svg" },
  { "id": "epic.champions_share",   "type": "EpicTale", "name": "The Champion's Share", "count": 1, "verified": true , "text": "Add the Action card that was set aside during the Assembly to your hand.", "art": "cards/epic/champions_share.svg" },
  { "id": "epic.stone_of_fal",      "type": "EpicTale", "name": "The Stone of Fal",     "count": 1, "verified": true,  "text": "Place two clans in a single territory where you are present.", "art": "cards/epic/stone_of_fal.svg" },
  { "id": "epic.oengus_ploy",       "type": "EpicTale", "name": "Oengus's Ploy",        "count": 1, "verified": true , "text": "(Triskel) At the end of any player's turn, take the next turn yourself; a Season that was about to end continues instead.", "art": "cards/epic/oengus_ploy.svg" },
  { "id": "epic.tailtus_land",      "type": "EpicTale", "name": "Tailtu's Land",        "count": 1, "verified": true , "text": "Draw territory tiles and place one of them in an empty spot touching two territories.", "art": "cards/epic/tailtus_land.svg" },
  { "id": "epic.breas_tyranny",     "type": "EpicTale", "name": "Breas' Tyranny",       "count": 1, "verified": true , "text": "Move one opposing clan from a territory where you are present into an adjacent territory; this never starts a clash.", "art": "cards/epic/breas_tyranny.svg" },
  { "id": "epic.ogmas_eloquence",   "type": "EpicTale", "name": "Ogma's Eloquence",     "count": 1, "verified": true,  "text": "(Triskel, as a maneuver) Immediately end the current clash.", "art": "cards/epic/ogmas_eloquence.svg" },
  { "id": "epic.strengs_resolve",   "type": "EpicTale", "name": "Streng's Resolve",     "count": 1, "verified": true , "text": "(Triskel) After you perform an Attack maneuver, gain a Deed.", "art": "cards/epic/strengs_resolve.svg" },
  { "id": "epic.the_dagda",         "type": "EpicTale", "name": "The Dagda",            "count": 1, "verified": true , "text": "(Triskel) When an Epic Tale or Advantage card is played, cancel its effect; the card is discarded.", "art": "cards/epic/the_dagda.svg" },
  { "id": "epic.manannans_horses",  "type": "EpicTale", "name": "Manannan's Horses",    "count": 1, "verified": true , "text": "Move up to three of your clans from one territory to any other territory on the island; this never starts a clash.", "art": "cards/epic/manannans_horses.svg" },
  { "id": "epic.children_of_dana",  "type": "EpicTale", "name": "Children of Dana",     "count": 1, "verified": true , "text": "Place one of your clans in any territory; this never starts a clash.", "art": "cards/epic/children_of_dana.svg" },
  { "id": "epic.the_fianna",        "type": "EpicTale", "name": "The Fianna",           "count": 1, "verified": true , "text": "(Triskel, as a maneuver) Move one or more of your clans, sheltered or exposed, from the clashing territory to an adjacent territory; this never starts a clash.", "art": "cards/epic/the_fianna.svg" },
  { "id": "epic.maeves_wealth",     "type": "EpicTale", "name": "Maeve's Wealth",       "count": 1, "verified": true , "text": "Every player who can must give you an Action card; then give one Action card back to each player who gave you one.", "art": "cards/epic/maeves_wealth.svg" },
  { "id": "epic.lug_samildanach",   "type": "EpicTale", "name": "Lug Samildanach",      "count": 1, "verified": true,  "text": "(Triskel) Keep a card that has just been cancelled by Geis instead of discarding it.", "art": "cards/epic/lug_samildanach.svg" },
  { "id": "epic.nuada_silverhand",  "type": "EpicTale", "name": "Nuada Silverhand",     "count": 1, "verified": true , "text": "In each territory where you are the chieftain, you may place one clan for each opponent present there.", "art": "cards/epic/nuada_silverhand.svg" }
]
