# Normalize line endings: LF in the repo for all text files.
* text=auto eol=lf

# Godot files are always LF (the editor writes LF on every platform).
*.godot text eol=lf
*.tscn text eol=lf
*.tres text eol=lf
*.import text eol=lf
*.cfg text eol=lf

# Windows-specific files keep CRLF.
*.bat text eol=crlf
*.ps1 text eol=crlf

# Binary assets — never touch.
*.png binary
*.jpg binary
*.wav binary
*.ogg binary
*.ttf binary
*.keystore binary
*.p12 binary
*.pfx binary
*.ico binary
*.icns binary
